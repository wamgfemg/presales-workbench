# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，绝不提交仓库
# 服务器上由 deploy/setup.sh 自动生成，权限 600

# BFF 监听端口（避开被 WeKnora 占用的 80）
PORT=8088
BIND_HOST=0.0.0.0

# 前端静态目录（容器内路径）
FRONT_DIR=/app/frontend

# 会话映射持久化目录（容器内路径），需与 docker run 的 -v /opt/presales-workbench/data:/app/data 对应
DATA_DIR=/app/data

# Hermes Agent 控制台地址。容器使用 --network host，所以走本机回环即可，不暴露公网
HERMES_URL=http://127.0.0.1:9119
HERMES_USER=admin
HERMES_PASS=替换为_Hermes_控制台密码
HERMES_PROFILE=wordpresales

# 会话池：最多同时保持 8 个 Hermes 会话，45 分钟无活动自动回收（控内存）
HERMES_MAX_SESSIONS=8
HERMES_SESSION_TTL_MS=2700000

# 单回合最长 5 分钟；回合内 2.5 分钟无事件判为失败
HERMES_TURN_TIMEOUT_MS=300000
HERMES_IDLE_TIMEOUT_MS=150000

# WeKnora 知识库（向量知识库打通）
# WEKNORA_URL 在容器内通过 --network host 访问本机 8080
WEKNORA_URL=http://127.0.0.1:8080
WEKNORA_API_KEY=替换为_WeKnora_API_Key
WEKNORA_KB_ID=替换为_知识库_ID

# 业务数据落库（SQLite，Node 22 内置 node:sqlite，无需额外依赖）
# 库文件名相对 DATA_DIR，默认 presales.db；同目录还有 -wal/-shm 附属文件
DB_FILE=presales.db
# 单个集合（projects/docs/pdocs…）整块 JSON 写入的体积上限，默认 16MB
MAX_STATE_BODY=16777216
# 上传资料原件（项目知识库文件 / 合同附件 / 报价 Excel）单文件上限，默认 32MB
# 原件以 BLOB 存在同一个库里，整个文件会先进内存再写库，所以不要调到接近容器 --memory 320m 的量级
MAX_DB_FILE=33554432

# 限制 Node 堆大小，配合容器 --memory 320m
NODE_OPTIONS=--max-old-space-size=192
